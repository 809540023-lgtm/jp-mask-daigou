# 訂單收件信箱（客戶送出表單後寄到這裡）
ORDER_TO=cia8885@gmail.com

# 主要寄信方式：Gmail 應用程式密碼（到 https://myaccount.google.com/apppasswords 產生）
# 沒填的話，系統會自動改用 FormSubmit 代理寄送（第一次使用需到信箱點一次啟用連結）
GMAIL_USER=cia8885@gmail.com
GMAIL_APP_PASSWORD=

# 或者自架 SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=日本嚴選代購 <no-reply@example.com>

# 開發用
PORT=3000
ORDER_LOG_DIR=./data
